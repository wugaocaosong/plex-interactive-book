{
  "name": "plex-interactive-book",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run assets",
    "dev": "vitepress dev web --host 127.0.0.1 --port 5190",
    "import:book": "python scripts/import_book.py && python scripts/prepare-learning.py",
    "build:learning": "python scripts/prepare-learning.py",
    "check:learning": "python scripts/prepare-learning.py --check",
    "build:activity": "python scripts/prepare-h5p.py && python scripts/prepare-h5p.py --monty && npm run assets",
    "assets": "node scripts/prepare-assets.mjs",
    "check:content": "python scripts/audit_content.py",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run check:content && npm run check:inputs && npm run check:learning && npm test",
    "build": "npm run assets && npm run check:content && npm run check:learning && vitepress build web",
    "preview": "vitepress preview web --host 127.0.0.1 --port 5190",
    "serve:dist": "node scripts/serve-dist.mjs",
    "prepackage": "npm run build",
    "package": "python scripts/package-release.py",
    "test": "node --test tests/*.test.mjs && python tests/import_test.py",
    "test:e2e": "playwright test",
    "check:inputs": "python scripts/prepare-input-models.py"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@fontsource/noto-sans-sc": "5.2.7",
    "@fontsource/noto-serif-sc": "5.2.6",
    "@huggingface/transformers": "4.3.2",
    "@mediapipe/tasks-vision": "0.10.32",
    "@orama/orama": "3.1.18",
    "@tresjs/core": "5.10.0",
    "@vueuse/core": "12.8.2",
    "codemirror": "6.0.2",
    "echarts": "6.1.0",
    "h5p-standalone": "3.8.2",
    "katex": "0.16.22",
    "lucide-vue-next": "0.468.0",
    "motion-v": "2.8.0",
    "page-flip": "2.0.7",
    "pyodide": "314.0.7",
    "quarks.core": "0.17.1",
    "roughjs": "4.6.6",
    "shiki": "2.5.0",
    "three": "0.187.0",
    "three.quarks": "0.17.1",
    "vitepress": "1.6.4",
    "vosk-browser": "0.0.8",
    "vue": "3.5.22",
    "vue-echarts": "8.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@types/katex": "0.16.7",
    "@types/node": "24.7.2",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1"
  }
}
