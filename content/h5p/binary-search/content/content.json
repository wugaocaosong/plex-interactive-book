                  "cancelLabel": "Cancel",
                  "confirmLabel": "Confirm"
                },
                "question": "<p>二分查找要求待查找的数组具备什么条件？</p>",
                "answers": [
                  {
                    "text": "<p>元素已经有序排列</p>",
                    "correct": true,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "二分查找通过有序关系排除一半范围；正负数与奇偶长度不影响这一前提。",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<p>元素必须全部为正数</p>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "二分查找通过有序关系排除一半范围；正负数与奇偶长度不影响这一前提。",
                      "notChosenFeedback": ""
                    }
                  },
                  {
                    "text": "<p>数组长度必须是偶数</p>",
                    "correct": false,
                    "tipsAndFeedback": {
                      "tip": "",
                      "chosenFeedback": "二分查找通过有序关系排除一半范围；正负数与奇偶长度不影响这一前提。",
                      "notChosenFeedback": ""
                    }
                  }
                ]
              },
