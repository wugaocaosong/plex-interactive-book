{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "allowJs": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vite/client"]
  },
  "include": ["web/.vitepress/**/*.ts", "web/.vitepress/**/*.vue"]
}
